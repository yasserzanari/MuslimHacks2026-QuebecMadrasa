# Copy to .env.local. .env.local is ignored by Git and must never contain a real child's data.

# Local adapters. `mock` runs a deterministic generator with no network and no key.
AI_PROVIDER=mock
LIVE_PROVIDER=mock
STORAGE_PROVIDER=local
DATABASE_URL=file:./dev.db
APP_BASE_URL=http://localhost:3000

# Set AI_PROVIDER=anthropic to call the real API. The key is read on the server only:
# route handlers and the generation worker. It is never sent to the browser.
# Without a key the app silently falls back to the mock rather than failing.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
